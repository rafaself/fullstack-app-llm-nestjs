# Model selections and shared AI defaults live in packages/ai/src/config.ts.
# Configure credentials only for providers selected there.
AWS_REGION=us-east-1
# Bedrock: bearer token OR both AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional OpenAI endpoint (uses Responses for language models).
# OPENAI_BASE_URL=https://api.openai.com/v1

DATABASE_URL=postgresql://chatbot:chatbot@127.0.0.1:15432/chatbot
# Production uses one login per service instead of DATABASE_URL:
# BUSINESS_DATABASE_URL=postgresql://chatbot_business:<secret>@db:5432/chatbot
# AGENT_DATABASE_URL=postgresql://chatbot_agent:<secret>@db:5432/chatbot
# WORKER_DATABASE_URL=postgresql://chatbot_worker:<secret>@db:5432/chatbot
# MIGRATION_DATABASE_URL is set only on the one-off migration job.
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
MAILPIT_URL=http://127.0.0.1:18025

# Demo credentials are disabled when NODE_ENV=production. Keep these local only.
DEMO_CUSTOMER_TOKEN=demo-customer-token-change-me
VITE_DEMO_CUSTOMER_TOKEN=demo-customer-token-change-me
SUPPORT_APPROVAL_TOKEN=demo-support-token-change-me
WORKER_API_TOKEN=local-worker-token-change-me

# Local/test placeholder only; production rejects this example key.
# Generate a production secret with: openssl rand -base64 32
WORKFLOWS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PORT=3000
AGENT_API_PORT=3001
# Number of trusted reverse proxy hops. Keep 0 if clients can reach the app directly.
# Trusted proxies must overwrite X-Forwarded-For before forwarding requests.
TRUST_PROXY_HOPS=0
BUSINESS_API_URL=http://127.0.0.1:3000

# Optional minimum Nest log level: fatal, error, warn, log, debug, verbose.
# Defaults: development=debug, test=warn, production=log.
# Production logs use JSON; development and test logs use readable text.
# LOG_LEVEL=debug
